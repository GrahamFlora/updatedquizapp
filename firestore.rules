rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Shared exams collection accessible across all devices and sessions
    match /exams/{examId} {
      allow read, write: if true;
    }

    // User-specific profile, history, and starred questions
    // Allows real-time multi-device synchronization across phone, PC, and browsers
    match /users/{userId} {
      allow read, write: if true;
      
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }
  }
}

